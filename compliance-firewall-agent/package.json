{
  "name": "houndshield",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "22.22.2"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "next dev",
    "dev:ws": "tsx server.ts",
    "build": "next build --webpack",
    "start": "next start",
    "start:ws": "NODE_ENV=production node server.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:components": "vitest run",
    "test:components:watch": "vitest",
    "test:components:ui": "vitest --ui",
    "db:migrate": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "email:preview": "tsx scripts/send-founder-email.ts",
    "email:send": "tsx scripts/send-founder-email.ts",
    "seed:demo": "node scripts/seed-demo-telemetry.mjs",
    "prepare": "git -C .. config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.3",
    "better-auth": "^1.7.6",
    "framer-motion": "^13.4.4",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.0",
    "posthog-js": "^1.434.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "resend": "^6.30.0",
    "stripe": "^22.6.2",
    "viem": "^2.56.9",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
