{
  "name": "houndshield-proxy",
  "version": "2.0.0",
  "description": "Hound Shield local AI DLP proxy — OODA loop with behavioral baselines, graduated response, and CUI/PII/PHI scanning",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "bench": "tsx bench/scan-bench.ts",
    "test:watch": "vitest --reporter=verbose",
    "test:coverage": "vitest run --coverage --reporter=verbose"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.1",
    "@types/node": "^26.2.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.22.2"
  },
  "packageManager": "npm@10.9.7"
}
